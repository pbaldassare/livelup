<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifiche push (APNs). Con la firma automatica Xcode attiva la
	     capability sull'App ID; l'archivio per l'App Store passa da solo a
	     "production". Vedi docs/PUSH.md. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
